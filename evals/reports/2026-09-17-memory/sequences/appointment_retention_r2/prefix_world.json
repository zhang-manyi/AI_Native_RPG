    "loren_that_night": {
      "fact_id": "loren_that_night",
      "value": "洛伦以为那晚是他弄死了艾拉——他撞到的人确实倒了，但那是擦伤，她爬起来继续走了",
      "visibility": "hidden",
      "reveal_condition": {
        "mode": "any",
        "clauses": [
          {
            "path": "story_beats.flags",
            "op": "contains",
            "value": "told_loren_truth"
          }
        ]
      },
      "partial_value": "村里有人知情，但没人愿意先开口"
    },
    "npc_b_aware_of_investigation": {
      "fact_id": "npc_b_aware_of_investigation",
      "value": "洛伦已经知道有人在村里打听那天晚上的事",
      "visibility": "hidden",
      "reveal_condition": {
        "mode": "any",
        "clauses": [
