    "ella_things_missing": {
      "fact_id": "ella_things_missing",
      "value": "艾拉的外衣不在，她攒下的钱不在，她母亲留下的那只木梳也不在——可别的东西都还在",
      "visibility": "hidden",
      "reveal_condition": {
        "mode": "any",
        "clauses": [
