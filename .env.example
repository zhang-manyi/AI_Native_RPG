# Copy to .env and fill in your key. .env is gitignored and must never be committed.
#
#   cp .env.example .env

# --- which backend to use ---------------------------------------------------
# "deepseek" (default) or "openai". Both speak the same OpenAI-compatible
# chat/completions surface, so this only picks which variables below are read —
# there is no second client implementation.
LLM_PROVIDER=deepseek

# DeepSeek (OpenAI-compatible endpoint)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI, or any OpenAI-compatible relay/proxy. Set LLM_PROVIDER=openai to use
# these. BASE_URL must be the root the /chat/completions path hangs off — for a
# relay that is usually the host plus /v1, e.g. https://your-relay.example/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Model used for LLM-as-judge scoring. Kept separate from the model under test:
# using the same model to generate and to grade its own output biases the score.
JUDGE_MODEL=deepseek-v4-flash

# Set to 1 to use the mock LLM client and make no network calls at all.
# Tests always force this on regardless of what is set here.
USE_MOCK_LLM=0

# Local embedding weights for semantic memory retrieval. Optional: without it the
# dependency-free HashingEmbedder is used, which matches characters rather than
# meaning. The backend is chosen by extension — a .gguf file goes through
# llama-cpp-python, anything else through sentence-transformers.
#   EMBEDDING_MODEL_PATH=/path/to/Qwen3-Embedding-0.6B-Q8_0.gguf
EMBEDDING_MODEL_PATH=
